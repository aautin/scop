#version 330 core

// Input from vertex shader (assumed to be in world space)
in vec3 vPosition;
in vec3 vColor;
in vec2 vTexCoord;
in vec3 vNormal;

// Texture properties
uniform sampler2D uTexture;
uniform int uUseTexture;

// Material properties
uniform vec3  uKa;    // Ambient color
uniform vec3  uKd;    // Diffuse color
uniform vec3  uKs;    // Specular color
uniform float uNs;    // Shininess
uniform float uNi;    // Index of refraction (unused in this shader)
uniform float uD;     // Dissolve (opacity, clamped to [0,1])
uniform int   uIllum; // Illumination model (0=color, 1=diffuse, 2=Phong)

// Light properties
uniform vec3 uLightPosition;
uniform vec3 uLightColor;

// Camera position
uniform vec3 uCameraPosition;

// Final pixel
out vec4 FragColor;

// Helper function for gamma correction (optional)
vec3 gammaCorrect(vec3 color) {
    return pow(color, vec3(1.0 / 2.2));
}

void main() {
    // Clamp dissolve to [0, 1] to avoid invalid alpha
    float opacity = clamp(uD, 0.0, 1.0);

    // Base color (from texture or vertex color)
    vec4 baseColor = uUseTexture == 1 ? texture(uTexture, vTexCoord) : vec4(vColor, 1.0);
    baseColor.a *= opacity; // Apply dissolve to alpha

    // Normalize the normal (in case it's not already)
    vec3 normal = normalize(vNormal);

    // Light direction (from surface to light)
    vec3 lightDir = normalize(uLightPosition - vPosition);

    // View direction (from surface to camera)
    vec3 viewDir = normalize(uCameraPosition - vPosition);

    // Ambient lighting
    vec3 ambient = uKa * uLightColor;

    // Diffuse lighting
    float diff = max(dot(normal, lightDir), 0.0);
    vec3 diffuse = uKd * diff * uLightColor;

    // Specular lighting (Phong model)
    vec3 specular = vec3(0.0);
    if (uIllum == 2) { // Only apply specular if illumination model is Phong (2)
        vec3 halfVector = normalize(lightDir + viewDir);
        float spec = pow(max(dot(normal, halfVector), 0.0), uNs);
        specular = uKs * spec * uLightColor;
    }

    // Combine lighting
    vec3 lighting = ambient + diffuse + specular;

    // Final color (apply lighting and gamma correction)
    FragColor = vec4(baseColor.rgb * lighting, baseColor.a);

    // Optional: Apply gamma correction (if texture is sRGB)
    // FragColor.rgb = gammaCorrect(FragColor.rgb);
}