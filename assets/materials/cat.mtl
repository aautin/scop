newmtl CatMaterial  # Define a new material named "CatMaterial"
Ka 1.0 1.0 1.0      # Ambient color (white)
Kd 1.0 1.0 1.0      # Diffuse color (white)
Ks 0.0 0.0 0.0      # Specular color (black, no specular highlights)
Ns 0.0              # Shininess (0 = no specular highlights)
d 1.0               # Dissolve (1.0 = fully opaque)
illum 1             # Illumination model (1 = diffuse only)

# Reference the texture for diffuse color
map_Kd textures/plankoCat.png